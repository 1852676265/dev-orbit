{
  "name": "dev-orbit",
  "version": "1.1.1",
  "description": "DevOrbit - 个人开发者工作台：本地任务归档、SQL发布跟踪与资产管理",
  "main": "electron/main.js",
  "author": "LiSB",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"electron .\"",
    "build": "vite build",
    "pack:exe": "vite build && electron-packager . DevOrbit --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"^(src|release|.git)\""
  },
  "dependencies": {
    "lucide-vue-next": "^0.453.0",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.9"
  },
  "build": {
    "appId": "com.devorbit.app",
    "productName": "DevOrbit",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  }
}
